    "name": "SOAT4 04 - Reparo e entrega apos pagamento real",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Continuar a OS criada na coleção 01, após pagamento real de teste. A primeira verificação interrompe se não houver CONFIRMADO; a seguinte comprova o recurso no provedor. Não executar para inventar autorização financeira."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get(\"base_url\")) { throw new Error(\"Selecione o environment SOAT Fase 4\"); }",
          "if (!pm.environment.get(\"trace_id\")) pm.environment.set(\"trace_id\", pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g,\"\"));",
          "pm.environment.set(\"traceparent\", \"00-\"+pm.environment.get(\"trace_id\")+\"-\"+pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g,\"\").slice(0,16)+\"-01\");"
        ]
      }
    }
  ],
