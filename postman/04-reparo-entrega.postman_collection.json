                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "",
                  "check('HTTP de consulta assincrona',code===200 || code===404);",
                  "const ready=code===200 && (data.status==='AGUARDANDO_EXECUCAO');",
                  "const key='poll_'+pm.info.requestId;",
                  "if (!ready) {",
                  " const count=Number(pm.environment.get(key)||0)+1;",
                  " pm.environment.set(key,count);",
                  " check('Convergencia em ate 90 consultas',count<=90);",
                  " pm.execution.setNextRequest(pm.info.requestId); setTimeout(function(){},800);",
                  "} else { pm.environment.unset(key); check('Estado esperado confirmado',true);  }"
                ]
              }
            }
          ]
        },
