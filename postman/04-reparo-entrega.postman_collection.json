      "item": [
        {
          "id": "d80761d9-7d5f-5aae-bd37-72ba3c99c787",
          "name": "01 Login demo-admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "traceparent",
                "value": "{{traceparent}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo-admin\",\n  \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "check(\"HTTP esperado [200]\", [200].includes(code));",
                  "check('Token recebido', !!data.accessToken);",
                  "pm.environment.set(\"admin_token\",data.accessToken);",
                  "pm.environment.set(\"admin_token_refresh\",data.refreshToken);",
                  "const claims=JSON.parse(atob(data.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "check('JWT com emissor e prazo corretos',claims.iss==='workshop-auth' && claims.exp>Date.now()/1000);"
                ]
              }
            }
          ]
        },
