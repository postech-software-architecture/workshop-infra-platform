{
  "info": {
    "_postman_id": "3bfa3e96-bf8d-569b-a7bf-8a2013fee622",
    "name": "SOAT4 03 - Mercado Pago de teste e limites",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requer mp_access_token privado da conta vendedora de teste. Leitura de recursos reais e teste negativo de webhook. Pagamento/QR dependem de configuração do Billing e compra assistida; ausência de providerOrderId é bloqueio, nunca sucesso financeiro."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get(\"base_url\")) { throw new Error(\"Selecione o environment SOAT Fase 4\"); }",
          "if (!pm.environment.get(\"trace_id\")) pm.environment.set(\"trace_id\", pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g,\"\"));",
          "pm.environment.set(\"traceparent\", \"00-\"+pm.environment.get(\"trace_id\")+\"-\"+pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g,\"\").slice(0,16)+\"-01\");"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Credenciais, recurso real e webhook negativo",
      "description": "",
      "item": [
        {
          "id": "669e0c6d-b94c-540f-a572-702f442162ca",
          "name": "01 Conferir vendedor no Mercado Pago",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "traceparent",
                "value": "{{traceparent}}"
              }
            ],
            "url": "https://api.mercadopago.com/users/me",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mp_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "check(\"HTTP esperado [200]\", [200].includes(code));",
                  "check('Conta de teste e vendedor esperado',String(data.id)===String(pm.environment.get('mp_seller_id')) && Array.isArray(data.tags) && data.tags.includes('test_user')); check('Pais BR',data.site_id==='MLB');"
                ]
              }
            }
          ]
        },
        {
          "id": "5b6db293-4b69-5ea2-9a97-690446239e32",
          "name": "02 Conferir lojas do vendedor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "traceparent",
                "value": "{{traceparent}}"
              }
            ],
            "url": "https://api.mercadopago.com/users/{{mp_seller_id}}/stores",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mp_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "check(\"HTTP esperado [200]\", [200].includes(code));",
                  "check('Lojas consultadas',Array.isArray(data.results));"
                ]
              }
            }
          ]
        },
        {
          "id": "a8d7de1b-4cf6-56fa-8cbe-35a41bfb76fa",
          "name": "03 Conferir caixa por external_id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "traceparent",
                "value": "{{traceparent}}"
              }
            ],
            "url": "https://api.mercadopago.com/pos?external_id={{mp_pos_id}}",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mp_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "check(\"HTTP esperado [200]\", [200].includes(code));",
                  "check('Caixa de demonstracao localizado',Array.isArray(data.results) && data.results.some(p=>p.external_id===pm.environment.get('mp_pos_id')));"
                ]
              }
            }
          ]
        },
        {
          "id": "d5c8b169-5175-5fea-8ec0-0b80f688ffc7",
          "name": "04 Consultar cobranca da OS no Billing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "traceparent",
                "value": "{{traceparent}}"
              }
            ],
            "url": "{{base_url}}/api/v1/pagamentos/{{main_payment_id}}",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "check(\"HTTP esperado [200]\", [200].includes(code));",
                  "check('Cobranca pertence ao orcamento',data.pagamento.budgetId===pm.environment.get('main_budget_id'));pm.environment.set('main_provider_order_id',data.pagamento.providerOrderId||'');pm.environment.set('main_qr_data',data.qrData||'');pm.environment.set('main_payment_state',data.pagamento.state);"
                ]
              }
            }
          ]
        },
        {
          "id": "ec42b5d5-09b5-59a1-943c-0d8ddf6e6a93",
          "name": "05 Webhook sem assinatura nao confirma pagamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "traceparent",
                "value": "{{traceparent}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/webhooks/mercado-pago?data.id=SOAT_TEST_NOTIFICATION",
            "description": "Teste negativo apenas. 503 significa segredo/configuração pendente; 401 significa recusa de assinatura ausente. Nunca comprova confirmação ou recebimento de webhook real.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"order\",\n  \"data\": {\n    \"id\": \"SOAT_TEST_NOTIFICATION\"\n  },\n  \"live_mode\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "check(\"HTTP esperado [401, 503]\", [401, 503].includes(code));",
                  "pm.environment.set('webhook_configuration_status',code===503?'PENDENTE_CONFIGURACAO':'CONFIGURADO_REJEITOU_SEM_ASSINATURA');"
                ]
              }
            }
          ]
        },
        {
          "id": "5f582d5a-2f57-5e2a-b2a9-e8266e0ac11d",
          "name": "06 Consultar recurso real da cobranca no provedor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "traceparent",
                "value": "{{traceparent}}"
              }
            ],
            "url": "https://api.mercadopago.com/v1/orders/{{main_provider_order_id}}",
            "description": "Só é enviada quando Billing possui providerOrderId; não cria cobrança avulsa nem simula pagamento.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mp_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.environment.get('main_provider_order_id')) {pm.execution.skipRequest();}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function check(name, condition) {",
                  "  pm.test(name, function () { pm.expect(Boolean(condition)).to.eql(true); });",
                  "  if (!condition) { pm.execution.setNextRequest(null); throw new Error(name); }",
                  "}",
                  "const code = pm.response.code;",
                  "let data = null;",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "check(\"HTTP esperado [200]\", [200].includes(code));",
                  "check('Recurso real de teste',data.live_mode===false);check('Referencia da mesma cobranca',data.external_reference==='workshop_'+pm.environment.get('main_payment_id').replace(/-/g,''));pm.environment.set('main_provider_status',data.status);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
